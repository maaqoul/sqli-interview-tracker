# Database
POSTGRES_DB=sqli_interviews
POSTGRES_USER=sqli
POSTGRES_PASSWORD=sqli_dev_password
DATABASE_URL=postgres://sqli:sqli_dev_password@db:5432/sqli_interviews

# Django
DJANGO_SECRET_KEY=change-me-in-production-use-50-chars-minimum
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Seed demo users/jobs on container start (production compose)
SEED_DEMO=1

# JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# AI
AI_PROVIDER=mock
OPENAI_API_KEY=sk-your-key-here
OLLAMA_BASE_URL=http://localhost:11434

# Frontend (empty = same-origin /api via nginx in production)
VITE_API_BASE_URL=
